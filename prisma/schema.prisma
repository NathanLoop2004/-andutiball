// Tablas de ÑandutíBall. Primera versión: vamos a ir cambiándola.
//
//   npm run base            levanta Postgres (docker-compose.base.yml)
//   npm run base:generar    genera el cliente de Prisma
//   npm run base:migrar     crea/actualiza las tablas y guarda la migración
//   npm run base:ver        abre Prisma Studio para mirar los datos
//
// La URL para las migraciones sale de DATABASE_URL (.env). En tiempo de ejecución
// manda DB_ENV y la URL del entorno (ver services/ConexionBase.js).

generator client {
  // El generador clásico: escribe JavaScript en node_modules/@prisma/client, que es lo
  // que necesita este proyecto (CommonJS con require). El generador nuevo
  // ("prisma-client") escribe TypeScript y no se puede requerir desde acá.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Una persona que entra a la sala. La identidad de verdad es el auth (Public ID de
// HaxBall); el nick se puede repetir y cambiar.
//
// Cada usuario tiene su CLAVE, atada a su nombre: así nadie le usa el nick.
// La clave nunca se guarda tal cual — se guarda el hash (ver lib/claves.js).
model Usuario {
  id              Int       @id @default(autoincrement())
  nick            String    @unique
  camiseta        String?   // la camiseta que tiene puesta, de las que compró
  animacion       String?   // la animación de gol que tiene puesta, de las que compró
  auth            String?   @unique
  clave           String?   // hash scrypt. null = todavía no se registró
  claveCambiada   DateTime?
  // El correo sirve para recuperar la cuenta. Es opcional para los que se registraron antes.
  email           String?   @unique
  // Recuperar la clave: se guarda el HASH del link que se mandó por correo (nunca el link
  // tal cual) y hasta cuándo sirve. Se borra apenas se usa.
  recuperarHash   String?   @unique
  recuperarVence  DateTime?
  // Cambiar la clave estando logueado: un código de 6 números que llega al correo.
  // Se guarda su hash, hasta cuándo sirve, cuántas veces se erró y cuándo se pidió.
  codigoHash      String?
  codigoVence     DateTime?
  codigoIntentos  Int       @default(0)
  codigoPedido    DateTime?
  // Discord vinculado (no es para iniciar sesión: solo se asocia la cuenta y se lo mete al servidor).
  // No se guarda ningún token de Discord: se usa una vez y se descarta.
  discordId        String?   @unique
  discordUsuario   String?
  discordAvatar    String?
  discordVinculado DateTime?
  // Mientras está yendo y viniendo de Discord: el hash del "state" (ata la vuelta a esta cuenta),
  // la dirección de vuelta que se usó y hasta cuándo sirve.
  discordEstadoHash  String?  @unique
  discordEstadoVence DateTime?
  discordVuelta      String?
  baneado        Boolean   @default(false)   // lo banea el OWNER desde la web: no puede entrar a ninguna sala
  motivoBan       String?
  baneadoEl       DateTime?
  elo             Int       @default(1000)
  partidos        Int       @default(0)
  ganados         Int       @default(0)
  empatados       Int       @default(0)
  perdidos        Int       @default(0)
  goles           Int       @default(0)
  asistencias     Int       @default(0)
  creado          DateTime  @default(now())
  visto           DateTime  @updatedAt

  participaciones Participacion[]
  rango           Rango?          @relation(fields: [rangoId], references: [id])
  rangoId         Int?

  @@map("usuarios")
}

// Cada sala del host (3v3, 4v4, todos, realsoccer)
model Sala {
  clave    String    @id
  nombre   String
  partidos Partido[]

  @@map("salas")
}

// Los parámetros de juego de cada sala, cambiados desde el panel (Configuración).
// Solo se guarda lo que alguien cambió: si no hay fila, vale lo de hosts/<sala>.json o lo
// que trae script.js. El catálogo de qué se puede tocar está en lib/parametros.js.
model ParametroSala {
  id            Int      @id @default(autoincrement())
  sala          String   // clave de la sala: 3v3 · 4v4 · todos · realsoccer
  nombre        String   // la variable de script.js (TiempoDeJuego, LimiteDeGoles…)
  valor         Json
  cambiadoPor   String?
  cambiado      DateTime @updatedAt

  @@unique([sala, nombre])
  @@map("parametros_sala")
}

// Comandos apagados. sala = "*" los apaga en todas las salas.
model ComandoApagado {
  id          Int      @id @default(autoincrement())
  sala        String
  comando     String   // con el "!": !afk, !elo…
  apagadoPor  String?
  apagado     DateTime @default(now())

  @@unique([sala, comando])
  @@map("comandos_apagados")
}

model Partido {
  id        Int       @id @default(autoincrement())
  sala      Sala?     @relation(fields: [salaClave], references: [clave])
  salaClave String?
  mapa      String?
  golesRed  Int       @default(0)
  golesBlue Int       @default(0)
  ganador   Int?      // 1 = red · 2 = blue · null = empate
  inicio    DateTime  @default(now())
  fin       DateTime?

  participaciones Participacion[]

  @@index([inicio])
  @@map("partidos")
}

// Quién jugó qué partido, de qué lado y cómo le fue con el ELO
model Participacion {
  id          Int     @id @default(autoincrement())
  partido     Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  partidoId   Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   Int
  equipo      Int     // 1 = red · 2 = blue
  goles       Int     @default(0)
  asistencias Int     @default(0)
  eloAntes    Int?
  eloDespues  Int?

  @@unique([partidoId, usuarioId])
  @@map("participaciones")
}

// Los rangos que hoy viven en roles.json (OWNER, CO-OWNER, ...)
model Rango {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  admin     Boolean   @default(false)
  orden     Int       @default(0)
  nicks     String[]  @default([])
  usuarios  Usuario[]

  @@map("rangos")
}

// Las novedades que se le cuentan a la gente en el Discord.
//
// Primero se guardan acá (estado "pendiente") y recién cuando alguien las revisa se mandan
// al webhook (estado "enviada"). Así nada sale al Discord sin que se lo haya leído antes.
//
// El texto va en castellano y en criollo: qué cambia para el que juega. Nada de nombres de
// archivos, funciones ni jerga (ver CLAUDE.md → "Actualizaciones para el Discord").
model Actualizacion {
  id      Int       @id @default(autoincrement())
  titulo  String?
  mensaje String
  origen  String    @default("manual")     // manual (cargada a mano) | commit
  commit  String?                          // el hash, si salió de un commit. Nunca se muestra en Discord
  estado  String    @default("pendiente")  // pendiente | enviada | error
  error   String?
  creada  DateTime  @default(now())
  enviada DateTime?

  @@index([estado, creada])
  @@map("actualizaciones")
}


// Las imágenes del carrusel de la portada. Se suben desde el panel (Carrusel) y la imagen
// misma se guarda acá (bytes), así no depende de archivos sueltos en el disco.
model ImagenCarrusel {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?
  enlace      String?  // opcional: a dónde lleva al tocarla (solo http/https)
  tipo        String   // image/png · image/jpeg · image/webp · image/gif
  tamano      Int      // en bytes
  datos       Bytes
  orden       Int      @default(0)
  activa      Boolean  @default(true)
  subidaPor   String?
  creada      DateTime @default(now())
  cambiada    DateTime @updatedAt

  @@index([activa, orden])
  @@map("imagenes_carrusel")
}

// ── ELO: una tabla por sala y una general ──
// Cada partido actualiza SOLO la tabla de su sala. La general no se toca a mano: la recalcula
// el procedimiento actualizar_elo_general() (ver la migración elo_por_sala) con el promedio de
// los ELO de cada sala, pesado por los partidos jugados en cada una.
// clave = "auth:<PublicID>" o, si no hay auth, "nick:<nombre>".
model Elo3v3 {
  clave       String   @id
  nombre      String
  elo         Int      @default(1000)
  partidos    Int      @default(0)
  ganados     Int      @default(0)
  empatados   Int      @default(0)
  perdidos    Int      @default(0)
  goles       Int      @default(0)
  actualizado DateTime @default(now())

  @@index([elo])
  @@map("elo_3v3")
}

model Elo4v4 {
  clave       String   @id
  nombre      String
  elo         Int      @default(1000)
  partidos    Int      @default(0)
  ganados     Int      @default(0)
  empatados   Int      @default(0)
  perdidos    Int      @default(0)
  goles       Int      @default(0)
  actualizado DateTime @default(now())

  @@index([elo])
  @@map("elo_4v4")
}

model EloTodos {
  clave       String   @id
  nombre      String
  elo         Int      @default(1000)
  partidos    Int      @default(0)
  ganados     Int      @default(0)
  empatados   Int      @default(0)
  perdidos    Int      @default(0)
  goles       Int      @default(0)
  actualizado DateTime @default(now())

  @@index([elo])
  @@map("elo_todos")
}

model EloRealsoccer {
  clave       String   @id
  nombre      String
  elo         Int      @default(1000)
  partidos    Int      @default(0)
  ganados     Int      @default(0)
  empatados   Int      @default(0)
  perdidos    Int      @default(0)
  goles       Int      @default(0)
  actualizado DateTime @default(now())

  @@index([elo])
  @@map("elo_realsoccer")
}

model EloGeneral {
  clave       String   @id
  nombre      String
  elo         Int      @default(1000)
  partidos    Int      @default(0)
  ganados     Int      @default(0)
  empatados   Int      @default(0)
  perdidos    Int      @default(0)
  goles       Int      @default(0)
  actualizado DateTime @default(now())

  @@index([elo])
  @@map("elo_general")
}

// Ajustes generales de la web: los cambia solo el OWNER (ver models/AjustesModel.js).
// Solo se guarda lo que se cambió; el resto sale del catálogo.
model Ajuste {
  clave       String   @id
  valor       Json
  cambiadoPor String?
  cambiado    DateTime @default(now())

  @@map("ajustes")
}

// Las monedas de cada cuenta. El saldo va en CENTÉSIMAS (1 moneda = 100), así 0,30 no se rompe.
model Monedas {
  nick        String   @id
  saldo       Int      @default(0)
  ganadas     Int      @default(0)
  gastadas    Int      @default(0)
  actualizado DateTime @default(now())

  @@map("monedas")
}

// Cada suma o resta de monedas, para poder mostrar el historial
model MovimientoMonedas {
  id           Int      @id @default(autoincrement())
  nick         String
  monto        Int
  motivo       String
  detalle      String?
  sala         String?
  partidoId    Int?
  saldoDespues Int
  creado       DateTime @default(now())

  @@index([nick, creado])
  @@map("movimientos_monedas")
}

// Las camisetas de los clubes (ver models/EquiposModel.js). Se editan desde el panel y la sala
// las aplica en vivo: el formato de HaxBall es ángulo + color del número + 3 franjas.
model Equipo {
  clave       String   @id
  nombre      String
  descripcion String?
  division    String?
  angulo      Int      @default(0)
  colorTexto  String   @default("FFFFFF")
  color1      String
  color2      String
  color3      String
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  // Tienda: precio en centésimas de moneda (null = no se vende)
  precio      Int?
  enTienda    Boolean  @default(false)
  detalle     String?
  cambiadoPor String?
  cambiado    DateTime @default(now())

  @@map("equipos")
}

// Cada camiseta que compró una cuenta
model CamisetaComprada {
  id       Int      @id @default(autoincrement())
  nick     String
  equipo   String
  precio   Int
  comprada DateTime @default(now())

  @@unique([nick, equipo])
  @@index([nick])
  @@map("camisetas_compradas")
}

// Los cruces del cambio automático: "demanda" es cuánto se repite ese clásico
model Clasico {
  id          Int      @id @default(autoincrement())
  red         String
  blue        String
  demanda     Int      @default(300)
  activo      Boolean  @default(true)
  cambiadoPor String?
  cambiado    DateTime @default(now())

  @@unique([red, blue])
  @@index([demanda])
  @@map("clasicos")
}

// Rachas: cuántas seguidas viene ganando cada cuenta y cuál fue su mejor (models/RachasModel.js)
model Racha {
  nick            String    @id
  actual          Int       @default(0)
  mejor           Int       @default(0)
  partidos        Int       @default(0)
  ganados         Int       @default(0)
  ultimoResultado String?
  mejorCuando     DateTime?
  actualizada     DateTime  @default(now())

  @@index([mejor])
  @@index([actual])
  @@map("rachas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Animaciones de gol: lo que se le hace al que hizo el gol mientras se festeja.
// Se arman desde el panel (solo OWNER y CO-OWNER) y se venden como las camisetas.
// ─────────────────────────────────────────────────────────────────────────────
model Animacion {
  clave       String   @id
  nombre      String
  descripcion String?
  // "secuencia" = le van pasando emojis o letras por el avatar
  // "tamano"    = se hace grande y chico
  // "ambas"     = las dos cosas a la vez
  tipo        String   @default("secuencia")
  // Hasta 10 cuadros: cada uno es un emoji o una letra (puede ir vacío si ese punto
  // solo cambia el tamaño)
  cuadros     String[] @default([])
  // El tamaño de cada punto, en paralelo a cuadros: mismo largo y misma posición.
  // Vacío = se usa el vaivén viejo entre tamanoDesde y tamanoHasta.
  tamanos     Float[]  @default([])
  msPorCuadro Int      @default(200)
  // Multiplicadores del tamaño normal del jugador (1 = como siempre)
  tamanoDesde Float    @default(1)
  tamanoHasta Float    @default(1.6)
  // Cuánto dura el festejo. Igual se corta sola cuando se saca del medio.
  duracionMs  Int      @default(3000)
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  // Tienda: precio en centésimas de moneda (null = no se vende)
  precio      Int?
  enTienda    Boolean  @default(false)
  detalle     String?
  cambiadoPor String?
  cambiado    DateTime @default(now())

  @@map("animaciones")
}

// Cada animación que compró una cuenta
model AnimacionComprada {
  id        Int      @id @default(autoincrement())
  nick      String
  animacion String
  precio    Int
  comprada  DateTime @default(now())

  @@unique([nick, animacion])
  @@index([nick])
  @@map("animaciones_compradas")
}
