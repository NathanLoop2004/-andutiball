{
  "name": "nandutihax-host",
  "version": "1.0.0",
  "private": true,
  "description": "Host de HaxBall ÑandutíHax ejecutado con Puppeteer",
  "main": "launcher.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env todas.js",
    "todas": "node --env-file-if-exists=.env todas.js",
    "check": "node --check script.js",
    "prueba": "node pruebas/simulador.js",
    "actualizacion": "node --env-file-if-exists=.env actualizacion.js",
    "tunel": "node --env-file-if-exists=.env tunel.js",
    "base": "docker compose -f docker-compose.base.yml up -d",
    "base:bajar": "docker compose -f docker-compose.base.yml down",
    "base:generar": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "base:sembrar": "node --env-file-if-exists=.env sembrar.js",
    "base:migrar": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "base:ver": "node --env-file-if-exists=.env node_modules/prisma/build/index.js studio",
    "prueba-base": "node --env-file-if-exists=.env pruebas/base.js",
    "prueba-actualizaciones": "node --env-file-if-exists=.env pruebas/actualizaciones.js",
    "prueba-usuarios": "node --env-file-if-exists=.env pruebas/usuarios.js",
    "prueba-nicks": "node pruebas/nicks.js",
    "prueba-rangos": "node --env-file-if-exists=.env pruebas/rangos.js",
    "prueba-web": "node --env-file-if-exists=.env pruebas/web.js",
    "prueba-tunel": "node pruebas/tunel.js",
    "prueba-api": "node pruebas/api.js",
    "prueba-espia": "node pruebas/espia.js",
    "prueba-chat": "node pruebas/chat.js",
    "prueba-camisetas": "node pruebas/camisetas.js",
    "generar-mapas": "node mapas/generar.js",
    "prueba-mapas": "node pruebas/mapa.js",
    "parchar": "node parches/aplicar.js",
    "tokens": "node get-tokens.js",
    "panel": "node --env-file-if-exists=.env panel/server.js",
    "prueba-turnos": "node pruebas/turnos.js",
    "prueba-arranque": "node pruebas/autoarranque.js && node pruebas/autoarranque.js hosts/3v3.json",
    "prueba-modos": "node pruebas/modos.js && node pruebas/modos.js hosts/4v4.json",
    "prueba-discord": "node pruebas/aviso-discord.js",
    "prueba-elo": "node pruebas/elo.js && node pruebas/elo-integracion.js && node pruebas/color-chat.js",
    "sala": "node --env-file-if-exists=.env launcher.js",
    "web": "node --env-file-if-exists=.env web.js",
    "web:bajar": "node --env-file-if-exists=.env web.js bajar",
    "web:estado": "node --env-file-if-exists=.env web.js estado",
    "prueba-config": "node --env-file-if-exists=.env pruebas/config.js",
    "prueba-carrusel": "node --env-file-if-exists=.env pruebas/carrusel.js",
    "prueba-elo-salas": "node --env-file-if-exists=.env pruebas/elo-salas.js",
    "prueba-discord-vincular": "node --env-file-if-exists=.env pruebas/discord-vincular.js",
    "prueba-monedas": "node --env-file-if-exists=.env pruebas/monedas.js",
    "elo:juntar": "node --env-file-if-exists=.env juntar-elo.js",
    "prueba-equipos": "node --env-file-if-exists=.env pruebas/equipos.js",
    "prueba-tienda": "node --env-file-if-exists=.env pruebas/tienda.js",
    "prueba-rachas": "node --env-file-if-exists=.env pruebas/rachas.js",
    "prueba-animaciones": "node --env-file-if-exists=.env pruebas/animaciones.js",
    "prueba-mercado": "node --env-file-if-exists=.env pruebas/mercado.js",
    "prueba-scores": "node --env-file-if-exists=.env pruebas/scores.js",
    "prueba-momentos": "node --env-file-if-exists=.env pruebas/momentos.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "puppeteer": "^23.0.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
