{
  "name": "nandutiball-host",
  "version": "1.0.0",
  "private": true,
  "description": "Host de HaxBall ÑandutíBall ejecutado con Puppeteer",
  "main": "launcher.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env launcher.js",
