# Copia este archivo como .env y coloca tus tokens
# Tokens del host headless de HaxBall: https://www.haxball.com/headlesstoken (vencen a los pocos minutos)
# Cada sala necesita su propio token.
TOKEN_3V3=
TOKEN_4V4=
TOKEN_TODOS=
TOKEN_REALSOCCER=

# Para una sola sala sin Docker (npm start)
HAXBALL_TOKEN=
HOST_CONFIG=hosts/todos.json

# Proxies opcionales por sala (para que HaxBall vea IPs distintas y liste las 4 salas)
# Formato: http://usuario:clave@ip:puerto  o  socks5://usuario:clave@ip:puerto
# Sin usuario/clave: http://ip:puerto
# Dejalos vacíos si esa sala tiene que salir por tu IP local.
PROXY_3V3=
PROXY_4V4=
PROXY_TODOS=
PROXY_REALSOCCER=

# Opcional: webhook de Discord que avisa cuando se abre una sala.
# Si lo ponés acá, pisa al que trae script.js y la llave no queda escrita en el repositorio.
WEBHOOK_SALA_ABIERTA=

# ───── Base de datos (docker-compose.base.yml + Prisma) ─────
# Entorno activo: produccion | testing | desarrollo. Manda sobre qué base se habla.
DB_ENV=desarrollo

# La URL que usan las migraciones de Prisma (npm run base:migrar)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nandutiball?schema=public

# Una URL por entorno. Si falta la del entorno activo, se usa DATABASE_URL.
DB_DESARROLLO_URL=postgresql://postgres:postgres@localhost:5432/nandutiball?schema=public
DB_TESTING_URL=
DB_PRODUCCION_URL=

# Webhook del canal de ACTUALIZACIONES: las novedades que se le cuentan a la gente
# (se guardan primero en la tabla actualizaciones y se mandan desde el panel)
WEBHOOK_ACTUALIZACIONES=

# Con qué se firman las sesiones de Ñandutí Web (el token dura 1 h 30 y se renueva solo).
# Si se cambia, todos tienen que volver a entrar.
JWT_SECRET=

# ───── Ñandutí Web afuera de localhost (Cloudflare) ─────
# Webhook donde se avisa el link público. Es UN solo mensaje que se va actualizando.
WEBHOOK_WEB=
# Con TUNEL_WEB=si, "npm start" abre el túnel solo junto con las salas
TUNEL_WEB=si
# Si cloudflared no está en el PATH, la ruta del ejecutable
CLOUDFLARED_BIN=

# ───── Correo (recuperar la cuenta) ─────
# Con Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords. Esa va en SMTP_CLAVE (no tu clave normal).
# Sin esto la web anda igual: el mail con el link se muestra en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE="ÑandutíBall <tu-cuenta@gmail.com>"
# La dirección que va en el link del mail. Vacío = el túnel de Cloudflare abierto, si no localhost.
WEB_URL=

# ───── Vincular Discord (Mi cuenta → "Vincular con Discord") ─────
# No es para iniciar sesión: asocia el Discord a la cuenta y lo mete al servidor.
# 1. https://discord.com/developers/applications → New Application
# 2. OAuth2: copiá el Client ID y el Client Secret. En "Redirects" agregá la dirección de vuelta:
#    <link de la web>/api/discord/vuelta   (ej. https://xxxx.trycloudflare.com/api/discord/vuelta)
# 3. Bot: creá el bot, copiá el token, e invitalo al servidor con el permiso "Crear invitación".
# 4. El ID del servidor: Discord → Ajustes → Avanzado → Modo desarrollador, y clic derecho al servidor.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# La dirección de vuelta registrada en Discord. Recomendado: la página puente de GitHub Pages
# (puente-discord/LEEME.md), que no cambia aunque cambie el link de Cloudflare.
# Vacío = el link de la web + /api/discord/vuelta (hay que actualizarlo en Discord cada vez que cambia)
DISCORD_REDIRECT_URI=
